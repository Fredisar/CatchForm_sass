<tr><td style="border:solid #D9DCE6 1pt;padding:4pt 6pt;font-size:9.5pt;font-weight:bold">password_hash</td><td style="border:solid #D9DCE6 1pt;padding:4pt 6pt;font-size:9.5pt">Texte (255)</td><td style="border:solid #D9DCE6 1pt;padding:4pt 6pt;font-size:9.5pt">Obligatoire</td><td style="border:solid #D9DCE6 1pt;padding:4pt 6pt;font-size:9.5pt">Empreinte du mot de passe</td></tr>
